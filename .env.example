# credential-proxy .env 示例 — 复制为 .env 后按需填值
# 必填
HOMESERVER=https://matrix.example.com
ROOM_ID=!yourroomid:matrix.example.com
MATRIX_ACCESS_TOKEN=syt_xxx
OBSERVABILITY_ADMIN_TOKEN=replace-with-32plus-random-string

# 三因子认证（建议开启）
# GET_BINARY_HASH=sha256:abc123...
# GET_BINARY_SECRET=abc123def456...

# LLM 脱敏代理
LLM_8878=https://api.opencode.ai
LLM_8879=https://api.deepseek.com

# PII 脱敏（默认关闭）
# PII_REDACTION_ENABLED=1
# PII_RESPONSE_SIDE=1
# PII_HOLD_MAX=64

# ── PII 值级掩码采样（dashboard-pii-value-details，默认关闭，仅掩码不存明文）──
# 默认仅计数；PII_VALUE_SAMPLE_ENABLED=1 时 PII 分布 hover 展示 TopN 掩码值及次数（Top5 聚合展示前3），
# hash 为 sha256(明文)[:16] 16hex 仅去重，masked_sample 形如 138****8000/a***@b.com/**** **** **** 6789/192.168.**.**/前4****后4，
# 掩码长度上限 64 超长截断。PII_VALUE_SAMPLE_PERSIST=1 时持久化到 metrics.sqlite:pii_value_agg 按日聚合，7 天滚动，0600 权限；默认 0 仅内存环精确 1h。
# 仅对话端点（is_chat_tail: chat/completions|v1/messages|v1/responses）触发采样，非对话不采样。
PII_VALUE_SAMPLE_ENABLED=0
PII_VALUE_SAMPLE_PERSIST=0

# 输出审计（默认关闭）
# AUDIT_MODE=block
# AUDIT_TIMEOUT=90
# AUDIT_HOLD_MAX_BYTES=1048576
# AUDIT_POLICY_FILE=/data/audit-policy.yaml
# APPROVAL_WHITELIST=@admin:matrix.example.com

# 可选
# CREDENTIAL_PORT=8877
# DATA_DIR=/data
# CREDENTIAL_PROXY_DEBUG_DIR=/data/debug
